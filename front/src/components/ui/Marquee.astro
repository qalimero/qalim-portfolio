---
export interface Props {
  text: string;
  className?: string;
  speed?: number;
  direction?: 'left' | 'right';
}

const { text, className = '', speed = 1, direction = 'left' } = Astro.props;
const repeatedText = Array(3).fill(text);
---

<div class={`marquee${className} static relative overflow-hidden whitespace-nowrap`} data-direction={direction} data-speed={speed}>
  <ul class="marquee__content inline-block">
    {repeatedText.map((item) => (
      <li class="marquee__content-item inline-block mr-8 font-medium">{item}</li>
    ))}
  </ul>
</div>


