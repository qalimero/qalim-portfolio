---
export interface Props {
  text: string | Array<{ text: string; link?: string }>;
  className?: string;
  speed?: number;
  direction?: 'left' | 'right';
}

const { text, className = '', speed = 1, direction = 'left' } = Astro.props;

// Handle both string and array inputs
let items: Array<{ text: string; link?: string }>;
if (typeof text === 'string') {
  items = [{ text, link: undefined }];
} else {
  items = text;
}

const repeatedItems = Array(3).fill(items).flat();
---

<div class={`marquee${className} sticky overflow-hidden whitespace-nowrap`} data-direction={direction} data-speed={speed}>
  <ul class="marquee__content inline-block">
    {repeatedItems.map((item) => (
      <li class="marquee__content-item inline-block mr-8 font-medium">
        {item.link ? <a href={item.link}>{item.text}</a> : item.text}
      </li>
    ))}
  </ul>
</div>


