---
import { Icon } from 'astro-icon/components'
export interface MarqueeItem {
  listItem: string;
  linkItem?: string | null;
}

export interface Props {
  items?: MarqueeItem[];
  text?: string;
  className?: string;
  speed?: number;
  direction?: 'left' | 'right';
}

const { items, text, className = '', speed = 1, direction = 'left' } = Astro.props;

// Support both new items format and legacy text format
// Keep the full item objects instead of just the text
const displayItems = items || (text ? [{ listItem: text, linkItem: null }] : []);
---

<div class={`marquee ${className} sticky overflow-hidden whitespace-nowrap w-full box-border relative z-[1]`} data-direction={direction} style={`--marquee-speed: ${speed};`}>
  <ul class="marquee__content inline-block pl-full list-none m-0 antialiased">
    {displayItems.map((item, index) => (
      <li class="inline-flex shrink-0 whitespace-nowrap marquee__content__item" key={`${index}`}>
        {item.linkItem ? (
          <a
            href={item.linkItem}
            target="_blank"
            rel="noopener noreferrer"
            class="marquee__link inline-flex items-center gap-2 uppercase text-inherit underline transition-all duration-300 ease-in-out"
          >
            <Icon class="shrink-0 marquee__content__item__icon" name="shuriken"/>
            <span class="tracking-tighter">{item.listItem}</span>
          </a>
        ) : (
          <span class="marquee__text inline-flex items-center gap-2 uppercase">
            <Icon class=" shrink-0 marquee__content__item__icon" name="shuriken"/>
            <span class="tracking-tighter">{item.listItem}</span>
          </span>
        )}
      </li>
    ))}
  </ul>
</div>
