---
/**
 * Marquee Component - Infinite scrolling marquee with rotating icons
 * Type-safe props without runtime validation to avoid SSR/client issues
 */
import { Icon } from 'astro-icon/components';
import type { MarqueeItem } from '../../content.config.ts';

// Props interface (type-only, no runtime validation)
export interface Props {
  items?: MarqueeItem[];
  text?: string;
  className?: string;
  speed?: number;
  direction?: 'left' | 'right';
}

// Get props with defaults
const {
  items,
  text,
  className = '',
  speed = 1,
  direction = 'left'
} = Astro.props as Props;

// Support both new items format and legacy text format
// Keep the full item objects instead of just the text
const displayItems: MarqueeItem[] = items || (text ? [{ listItem: text, linkItem: text }] : []);
---

<div class={`marquee ${className}`} data-direction={direction} style={`--marquee-speed: ${speed};`}>
  <ul class="marquee__content">
    {displayItems.map((item, index) => (
      <li class="marquee__content__item">
        {item.linkItem ? (
          <a
            href={item.linkItem}
            title={item.linkTitle}
            target="_blank"
            rel="noopener noreferrer"
            class="marquee__link"
          >
            <Icon class="marquee__content__item__icon" name="shuriken"/>
            <span class="marquee__content__item__text">{item.listItem}</span>
          </a>
        ) : (
          <p class="marquee__text">
            <Icon class="marquee__content__item__icon" name="shuriken"/>
            <span class="marquee__content__item__text">{item.listItem}</span>
          </p>
        )}
      </li>
    ))}
  </ul>
</div>
