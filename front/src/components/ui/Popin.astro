---
/**
 * Popin Component (Modal/Dialog)
 * Simple popin with text content and optional close button
 */
import { Icon } from 'astro-icon/components';

export interface Props {
  id: string;
  title?: string;
  closeable?: boolean;
  autoOpen?: boolean;
}

const {
  id,
  title,
  closeable = true,
  autoOpen = false,
} = Astro.props;
---

<dialog
  id={id}
  class="popin popin--brand"
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-label={!title ? 'Notification' : undefined}
  aria-modal="true"
  data-auto-open={autoOpen}
>
  <div class="popin__container">
    <!-- Header with optional close button -->
    {(title || closeable) && (
      <div class="popin__header">
        {title && (
          <h2 id={`${id}-title`} class="popin__title">
            {title}
          </h2>
        )}
        {closeable && (
          <button
            type="button"
            class="popin__close"
            aria-label="Fermer la fenêtre"
            data-popin-close
          >
              <Icon width="1.5rem"height="1.5rem" name="close" />
          </button>
        )}
      </div>
    )}

    <!-- Content -->
    <div class="popin__content">
      <slot />
    </div>
  </div>

  <!-- Backdrop — closes dialog on click -->
  <div class="popin__backdrop" data-popin-backdrop aria-hidden="true"></div>
</dialog>

<script>
  // Initialize popin functionality
  function initPopins() {
    document.querySelectorAll<HTMLDialogElement>('.popin').forEach((dialog) => {
      const closeButton = dialog.querySelector<HTMLButtonElement>('[data-popin-close]');
      const backdrop    = dialog.querySelector<HTMLElement>('[data-popin-backdrop]');

      // Restore focus to the element that triggered the dialog on close
      const closeAndRestoreFocus = () => {
        const trigger = (dialog as any)._trigger as HTMLElement | undefined;
        dialog.close();
        trigger?.focus();
      };

      closeButton?.addEventListener('click', closeAndRestoreFocus);
      backdrop?.addEventListener('click', closeAndRestoreFocus);

      // Auto-open if data-auto-open is true (no trigger to restore, focus stays on body)
      const autoOpen = dialog.getAttribute('data-auto-open') === 'true';
      if (autoOpen) {
        setTimeout(() => {
          dialog.showModal();
        }, 100);
      }
    });
  }

  // Global API
  (window as any).Popin = {
    open: (id: string, trigger?: HTMLElement) => {
      const dialog = document.getElementById(id) as HTMLDialogElement | null;
      if (!dialog) return;
      // Store the trigger so focus can be restored on close
      (dialog as any)._trigger = trigger ?? (document.activeElement as HTMLElement);
      dialog.showModal();
    },
    close: (id: string) => {
      (document.getElementById(id) as HTMLDialogElement)?.close();
    },
  };

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPopins);
  } else {
    initPopins();
  }

  // Re-initialize on View Transitions navigation (if enabled)
  document.addEventListener('astro:page-load', initPopins);
</script>
