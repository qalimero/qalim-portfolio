---
/**
 * TextMaintenance — Text block with orange border.
 *
 * Renders a container with:
 *  - Orange border (no fill), from design tokens
 *  - Width = 4 grid cells (320px)
 *  - Height adapts to content
 *
 * Content is configurable via site.config.json `maintenanceText.text` field.
 *
 * RGAA compliance:
 *  - Criterion 8.9: proper use of semantic markup
 */

export interface Props {
	text: string;
	class?: string;
}

const {
	text,
	class: className = "",
} = Astro.props;

const classes = ["text-maintenance", className].filter(Boolean).join(" ");
---

<div class={classes}>
  <p class="text-maintenance__text">{text}</p>
</div>
