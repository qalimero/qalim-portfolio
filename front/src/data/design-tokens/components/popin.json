{
  "components": {
    "popin": {
      "background": {
        "color": {
          "$value": "{foundation.color.neutral.darkest}",
          "$type": "color",
          "$description": "Popin background color"
        }
      },
      "text": {
        "color": {
          "$value": "{foundation.color.neutral.lightest}",
          "$type": "color",
          "$description": "Popin text color"
        },
        "size": {
          "$value": "{foundation.font.size.xs}",
          "$type": "fontSizes",
          "$description": "Base text size for popin content"
        }
      },
      "gap": {
        "y": {
          "$value": "{foundation.spacing.md}",
          "$type": "spacing",
          "$description": "Vertical gap between popin elements"
        }
      },
      "padding": {
        "xy": {
          "$value": "{foundation.spacing.lg}",
          "$type": "spacing",
          "$description": "Padding for popin container"
        }
      }
    }
  }
}
