{
  "foundation": {
    "color": {
      "brand": {
        "primary": {
          "$value": "#3200f2",
          "$type": "color",
          "$description": "Primary brand color - Powerful blue"
        },
        "secondary": {
          "$value": "#ff602f",
          "$type": "color",
          "$description": "Secondary brand color - Powerful orange"
        }
      },
      "neutral": {
        "darkest": {
          "$value": "#232121",
          "$type": "color",
          "$description": "Darkest neutral - Near black"
        },
        "lightest": {
          "$value": "#ffffff",
          "$type": "color",
          "$description": "Lightest neutral - Pure white"
        }
      }
    },
    "font": {
      "family": {
        "base": {
          "$value": ["Satoshi"],
          "$type": "fontFamily",
          "$description": "Base font family for body text"
        },
        "mono": {
          "$value": ["PP Fraktion Mono"],
          "$type": "fontFamily",
          "$description": "Monospace font for special text"
        }
      },
      "size": {
        "xxs": {
          "$value": "10px",
          "$type": "fontSizes",
          "$description": "Extra extra small font size"
        },
        "xs": {
          "$value": "16px",
          "$type": "fontSizes",
          "$description": "Extra small font size - base size"
        },
        "sm": {
          "$value": "26px",
          "$type": "fontSizes",
          "$description": "Small font size"
        },
        "md": {
          "$value": "42px",
          "$type": "fontSizes",
          "$description": "Medium font size"
        },
        "lg": {
          "$value": "68px",
          "$type": "fontSizes",
          "$description": "Large font size - for creative titles"
        },
        "xl": {
          "$value": "110px",
          "$type": "fontSizes",
          "$description": "Extra large font size - for creative titles"
        }
      }
    },
    "spacing": {
      "xxs": {
        "$value": "4px",
        "$type": "spacing",
        "$description": "Extra extra small spacing"
      },
      "xs": {
        "$value": "8px",
        "$type": "spacing",
        "$description": "Extra small spacing"
      },
      "sm": {
        "$value": "12px",
        "$type": "spacing",
        "$description": "Small spacing"
      },
      "md": {
        "$value": "16px",
        "$type": "spacing",
        "$description": "Medium spacing"
      },
      "lg": {
        "$value": "24px",
        "$type": "spacing",
        "$description": "Large spacing"
      },
      "xl": {
        "$value": "32px",
        "$type": "spacing",
        "$description": "Extra large spacing"
      },
      "2xl": {
        "$value": "40px",
        "$type": "spacing",
        "$description": "2x extra large spacing"
      },
      "3xl": {
        "$value": "48px",
        "$type": "spacing",
        "$description": "3x extra large spacing"
      },
      "4xl": {
        "$value": "64px",
        "$type": "spacing",
        "$description": "4x extra large spacing"
      },
      "5xl": {
        "$value": "80px",
        "$type": "spacing",
        "$description": "5x extra large spacing"
      }
    },
    "border": {
      "radius": {
        "sm": {
          "$value": "16px",
          "$type": "borderRadius",
          "$description": "Small border radius"
        },
        "md": {
          "$value": "40px",
          "$type": "borderRadius",
          "$description": "Medium border radius"
        }
      }
    }
  },
  "components": {
    "marquee": {
      "font": {
        "size": {
          "mobile": {
            "$value": "{foundation.font.size.xs}",
            "$type": "fontSizes",
            "$description": "Marquee font size on mobile"
          },
          "desktop": {
            "$value": "{foundation.font.size.sm}",
            "$type": "fontSizes",
            "$description": "Marquee font size on desktop"
          }
        },
        "color": {
          "$value": "{foundation.color.neutral.lightest}",
          "$type": "color",
          "$description": "Marquee text color"
        }
      },
      "background": {
        "color": {
          "$value": "{foundation.color.brand.primary}",
          "$type": "color",
          "$description": "Marquee background color"
        }
      },
      "border": {
        "radius": {
          "mobile": {
            "$value": "{foundation.border.radius.sm}",
            "$type": "borderRadius",
            "$description": "Marquee border radius on mobile"
          },
          "desktop": {
            "$value": "{foundation.border.radius.md}",
            "$type": "borderRadius",
            "$description": "Marquee border radius on desktop"
          }
        }
      },
      "item": {
        "gap": {
          "$value": "{foundation.spacing.md}",
          "$type": "spacing",
          "$description": "Gap between marquee items"
        }
      },
      "link": {
        "background": {
          "color": {
            "hover": {
              "$value": "{foundation.color.brand.secondary}",
              "$type": "color",
              "$description": "Marquee link background on hover"
            }
          }
        },
        "border": {
          "radius": {
            "hover": {
              "mobile": {
                "$value": "{foundation.border.radius.sm}",
                "$type": "borderRadius",
                "$description": "Marquee link border radius on hover (mobile)"
              },
              "desktop": {
                "$value": "{foundation.border.radius.md}",
                "$type": "borderRadius",
                "$description": "Marquee link border radius on hover (desktop)"
              }
            }
          }
        },
        "padding": {
          "vertical": {
            "hover": {
              "mobile": {
                "$value": "{foundation.spacing.xxs}",
                "$type": "spacing",
                "$description": "Marquee link vertical padding on hover (mobile)"
              },
              "desktop": {
                "$value": "{foundation.spacing.xs}",
                "$type": "spacing",
                "$description": "Marquee link vertical padding on hover (desktop)"
              }
            }
          },
          "horizontal": {
            "hover": {
              "mobile": {
                "$value": "{foundation.spacing.xs}",
                "$type": "spacing",
                "$description": "Marquee link horizontal padding on hover (mobile)"
              },
              "desktop": {
                "$value": "{foundation.spacing.md}",
                "$type": "spacing",
                "$description": "Marquee link horizontal padding on hover (desktop)"
              }
            }
          }
        }
      },
      "padding": {
        "horizontal": {
          "mobile": {
            "$value": "{foundation.spacing.md}",
            "$type": "spacing",
            "$description": "Marquee horizontal padding (mobile)"
          },
          "desktop": {
            "$value": "{foundation.spacing.lg}",
            "$type": "spacing",
            "$description": "Marquee horizontal padding (desktop)"
          }
        },
        "vertical": {
          "mobile": {
            "$value": "{foundation.spacing.xs}",
            "$type": "spacing",
            "$description": "Marquee vertical padding (mobile)"
          },
          "desktop": {
            "$value": "{foundation.spacing.md}",
            "$type": "spacing",
            "$description": "Marquee vertical padding (desktop)"
          }
        }
      }
    },
    "popin": {
      "background": {
        "color": {
          "$value": "{foundation.color.neutral.darkest}",
          "$type": "color",
          "$description": "Popin background color"
        }
      },
      "text": {
        "color": {
          "$value": "{foundation.color.neutral.lightest}",
          "$type": "color",
          "$description": "Popin text color"
        },
        "size": {
          "$value": "{foundation.font.size.xs}",
          "$type": "fontSizes",
          "$description": "Base text size for popin content"
        }
      },
      "gap": {
        "y": {
          "$value": "{foundation.spacing.md}",
          "$type": "spacing",
          "$description": "Vertical gap between popin elements"
        }
      },
      "padding": {
        "xy": {
          "$value": "{foundation.spacing.lg}",
          "$type": "spacing",
          "$description": "Padding for popin container"
        }
      }
    }
  }
}
