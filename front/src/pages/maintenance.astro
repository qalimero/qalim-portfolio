---
/**
 * Maintenance page - Displays maintenance message with animated marquee
 * Content managed via src/content/site.config.json (editable via Decap CMS)
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/scenes/ThreeScene.jsx';
import WebGLGrid from '../components/scenes/WebGLGrid.jsx';
import Marquee from '../components/ui/Marquee.astro';
import Popin from '../components/ui/Popin.astro';
import Link from '../components/ui/Link.astro';
import CircleTextShape from '../components/shapes/CircleTextShape.astro';

const entry = await getEntry('siteConfig', 'main');
if (!entry) throw new Error('Site config not found: src/content/site.config.json');

const { title, marquee, popinInfo, cta } = entry.data;
const isCtaExternal = cta?.href?.startsWith('http');
const popin = popinInfo?.[0];
---

<BaseLayout
  title={title}
  description="Retour très bientôt."
  bodyClass="page-maintenance"
>

  <!-- WebGL distortion grid background -->
  <WebGLGrid client:load />

  <section class="maintenance">

    {popin && (
      <Popin
        id="maintenance-popin"
        title={popin.title}
        closeable={popin.closable}
        autoOpen={true}
      >
        <p>{popin.text}</p>
      </Popin>
    )}

    <!-- Marquee content -->
    <div class="marquee-container">
      <Marquee items={marquee} />
    </div>

    {cta && cta.href && (
      <div class="maintenance__cta">
        <Link
          label={cta.label}
          href={cta.href}
          variant="shape-circle"
          shape={CircleTextShape}
          shapeProps={{ text: cta.shapeText }}
          srOnly={true}
          external={isCtaExternal}
        />
      </div>
    )}

    <!-- Three.js Scene (must be before CTA so card bounds are available) -->
    <div class="canvas-host">
      <ThreeScene client:load />
    </div>

  </section>

  <script>
    import { initFloatingCta } from '../lib/animations/floatingCta';

    // Wait for the Three.js card to load before starting the float.
    // The card sets window.__getCardScreenBounds once it's ready.
    function boot() {
      const ctaEl = document.querySelector('.maintenance__cta') as HTMLElement | null;
      if (!ctaEl) return;

      // Poll until card bounds are available (or start after 3 s anyway)
      let waited = 0;
      const interval = setInterval(() => {
        waited += 100;
        if (window.__getCardScreenBounds || waited >= 3000) {
          clearInterval(interval);
          initFloatingCta(ctaEl);
        }
      }, 100);
    }

    // Astro scripts are type="module" → deferred, DOM is ready
    boot();
  </script>
</BaseLayout>
