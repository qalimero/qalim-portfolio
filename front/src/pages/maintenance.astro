---
/**
 * Maintenance page — Split-screen layout.
 *
 * Desktop (≥ lg): Spline card on the left half, text block + CTA on the right.
 * Mobile (< lg): Horizontal snap-scroll — card fills first viewport, scroll right
 * reveals content panel with text block + CTA + scroll indicator.
 *
 * Content managed via src/content/site.config.json (editable via Decap CMS).
 */
import { getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import ThreeScene from "../components/scenes/ThreeScene.jsx";
import WebGLGrid from "../components/scenes/WebGLGrid.jsx";
import Marquee from "../components/ui/Marquee.astro";
import Popin from "../components/ui/Popin.astro";
import TextMaintenance from "../components/ui/TextMaintenance.astro";
import BaseLayout from "../layouts/Layout.astro";

const entry = await getEntry("siteConfig", "main");
if (!entry)
	throw new Error("Site config not found: src/content/site.config.json");

const { title, marquee, popinInfo, maintenanceText } = entry.data;
const isExternal = maintenanceText?.href?.startsWith("http");
const popin = popinInfo?.[0];
---

<BaseLayout
  title={title}
  description="Retour très bientôt."
  bodyClass="page-maintenance"
>

  <!-- WebGL distortion grid background -->
  <WebGLGrid client:load />

  <section class="maintenance">

    {popin && (
      <Popin
        id="maintenance-popin"
        title={popin.title}
        closeable={popin.closable}
        autoOpen={true}
      >
        <p>{popin.text}</p>
      </Popin>
    )}

    <!-- Marquee content -->
    <div class="marquee-container">
      <Marquee items={marquee} />
    </div>

    <!-- Horizontal scroll wrapper: two panels -->
    <div class="maintenance__panels">

      <!-- Left panel: Spline 3D card -->
      <div class="maintenance__panel maintenance__panel--card">
        <div class="canvas-host">
          <ThreeScene client:load />
        </div>
      </div>

      <!-- Right panel: text block + square CTA link -->
      <div class="maintenance__panel maintenance__panel--content">
        <div class="maintenance__content-stack">
          {maintenanceText && (
            <TextMaintenance text={maintenanceText.text} />
          )}

          {maintenanceText && maintenanceText.href && (
            <div class="maintenance__cta">
              <a
                class="maintenance-link"
                href={maintenanceText.href}
                {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <span class="maintenance-link__content">
                  <span class="maintenance-link__label">{maintenanceText.label}</span>
                  {maintenanceText.icon && (
                    <span class="maintenance-link__icon-wrapper">
                      <Icon
                        class="maintenance-link__icon"
                        name={maintenanceText.icon}
                        aria-hidden="true"
                        focusable="false"
                        width="1em"
                        height="1em"
                      />
                    </span>
                  )}
                  {isExternal && (
                    <span class="maintenance-link__sr-hint">{' '}(nouvelle fenêtre)</span>
                  )}
                </span>
              </a>
            </div>
          )}
        </div>

        <!-- Mobile scroll indicator -->
        <div class="maintenance__scroll-indicator" aria-hidden="true">
          <span class="maintenance__scroll-indicator-text">scroll</span>
          <svg class="maintenance__scroll-indicator-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </div>
      </div>

    </div>

  </section>

  <script>
    import { initStaticCta } from '../lib/animations/ctaPosition';
    import { initCtaReveal } from '../lib/webgl/ctaRevealScene';
    import { initTransitionScene } from '../lib/webgl/transitionScene';

    function boot() {
      const ctaEl = document.querySelector('.maintenance__cta') as HTMLElement | null;
      if (!ctaEl) return;

      const linkEl = ctaEl.querySelector<HTMLElement>('.maintenance-link');

      // Visibility timeline
      initStaticCta(ctaEl);

      // Pixel-creation overlay (synced with reveal)
      if (linkEl) {
        const ctaReveal = initCtaReveal(linkEl);
        if (ctaReveal) {
          setTimeout(() => ctaReveal.trigger(), 400);
        }
      }

      // WebGL2 pixel-wipe transition on link click → /home
      const transition = initTransitionScene();

      if (linkEl && transition) {
        linkEl.addEventListener('click', (e) => {
          const href = (linkEl as HTMLAnchorElement).href;
          if (!href) return;

          const destination = new URL(href, window.location.origin);
          if (destination.origin !== window.location.origin) return;

          e.preventDefault();
          transition.trigger(() => {
            window.location.href = `${destination.pathname}${destination.search}${destination.hash}`;
          });
        });
      }

      // Mobile: magnetic snap scroll
      initMagneticScroll();
    }

    function initMagneticScroll() {
      const panels = document.querySelector('.maintenance__panels');
      if (!panels || window.innerWidth >= 992) return;

      const indicator = document.querySelector('.maintenance__scroll-indicator');
      if (!indicator) return;

      // Hide indicator once user scrolls past 10% of content panel
      let indicatorHidden = false;
      panels.addEventListener('scroll', () => {
        if (indicatorHidden) return;
        const scrollRatio = panels.scrollLeft / (panels.scrollWidth - panels.clientWidth);
        if (scrollRatio > 0.1) {
          (indicator as HTMLElement).style.opacity = '0';
          indicatorHidden = true;
        }
      }, { passive: true });
    }

    boot();
  </script>
</BaseLayout>
