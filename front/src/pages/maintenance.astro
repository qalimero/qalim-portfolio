---
/**
 * Maintenance page - Displays maintenance message with animated marquee
 * Content managed via src/content/site.config.json (editable via Decap CMS)
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/scenes/ThreeScene.jsx';
import WebGLGrid from '../components/scenes/WebGLGrid.jsx';
import Marquee from '../components/ui/Marquee.astro';
import Popin from '../components/ui/Popin.astro';
import Link from '../components/ui/Link.astro';
import CircleTextShape from '../components/shapes/CircleTextShape.astro';

const entry = await getEntry('siteConfig', 'main');
if (!entry) throw new Error('Site config not found: src/content/site.config.json');

const { title, marquee, popinInfo, cta } = entry.data;
const isCtaExternal = cta?.href?.startsWith('http');
const popin = popinInfo?.[0];
---

<BaseLayout
  title={title}
  description="Retour très bientôt."
  bodyClass="page-maintenance"
>

  <!-- WebGL distortion grid background -->
  <WebGLGrid client:load />

  <section class="maintenance">

    {popin && (
      <Popin
        id="maintenance-popin"
        title={popin.title}
        closeable={popin.closable}
        autoOpen={true}
      >
        <p>{popin.text}</p>
      </Popin>
    )}

    <!-- Marquee content -->
    <div class="marquee-container">
      <Marquee items={marquee} />
    </div>

    {cta && cta.href && (
      <div class="maintenance__cta">
        <Link
          label={cta.label}
          href={cta.href}
          variant="shape-circle"
          shape={CircleTextShape}
          shapeProps={{ text: cta.shapeText }}
          srOnly={true}
          external={isCtaExternal}
        />
      </div>
    )}

    <!-- Three.js Scene (must be before CTA so card bounds are available) -->
    <div class="canvas-host">
      <ThreeScene client:load />
    </div>

  </section>

  <script>
    import { initStaticCta } from '../lib/animations/ctaPosition';
    import { initParticleScene } from '../lib/webgl/particleScene';
    import { initTransitionScene } from '../lib/webgl/transitionScene';

    function boot() {
      const ctaEl = document.querySelector('.maintenance__cta') as HTMLElement | null;
      if (!ctaEl) return;

      const btnEl = ctaEl.querySelector<HTMLElement>('.btn');

      // Static positioning + draw-on reveal animation
      initStaticCta(ctaEl);

      // WebGL2 pixel particle system (mouse + CTA hover)
      const particles = initParticleScene();

      // Keep CTA state in sync with hover and position
      if (particles && btnEl) {
        let ctaHovered = false;

        function updateCtaParticles() {
          const rect = btnEl!.getBoundingClientRect();
          particles!.setCtaState(
            ctaHovered,
            rect.left + rect.width  / 2,
            rect.top  + rect.height / 2,
            rect.width / 2,
          );
        }

        btnEl.addEventListener('pointerenter', () => {
          ctaHovered = true;
          updateCtaParticles();
        });

        btnEl.addEventListener('pointerleave', () => {
          ctaHovered = false;
          updateCtaParticles();
        });

        // Keep position fresh on scroll / resize
        window.addEventListener('resize', updateCtaParticles);
      }

      // WebGL2 pixel-wipe transition on CTA click → /terminal
      const transition = initTransitionScene();

      if (btnEl && transition) {
        btnEl.addEventListener('click', (e) => {
          const href = (btnEl as HTMLAnchorElement).href;
          if (!href || href.includes('/terminal')) {
            e.preventDefault();
            transition.trigger(() => {
              window.location.href = '/terminal';
            });
          }
        });
      }
    }

    // Astro scripts are type="module" → deferred, DOM is ready
    boot();
  </script>
</BaseLayout>
