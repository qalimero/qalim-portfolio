---
/**
 * Maintenance page - Displays maintenance message with animated marquee
 * Uses type-safe Strapi API with Zod validation
 * ONLY shows real data from Strapi - no fallback
 */
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/scenes/ThreeScene.jsx';
import Marquee from '../components/ui/Marquee.astro';
import Popin from '../components/ui/Popin.astro';
import { getMaintenancePage } from '../lib/api/strapi';
import { richTextToHtml } from '../lib/utils/richtext';
import type { MarqueeItem, PopinComponent } from '../lib/schemas/strapi.schema';

// Fetch maintenance data - no fallback, throws if API fails
const maintenanceData = await getMaintenancePage();

if (import.meta.env.DEV) {
  console.log('✓ Maintenance data fetched from Strapi:', {
    title: maintenanceData.data.title,
    marqueeCount: maintenanceData.data.marquee?.length || 0,
    hasPopin: !!maintenanceData.data.popinInfo?.length,
  });
}

// Extract data with type safety
const marqueeItems: MarqueeItem[] = maintenanceData.data.marquee || [];
const pageTitle: string = maintenanceData.data.title;

// Extract popin data from maintenance page (first popin in the array)
const popinData: PopinComponent | undefined = maintenanceData.data.popinInfo?.[0];

// Convert popin text (RichText blocks) to HTML
const popinContentHtml: string | undefined = popinData?.text
  ? richTextToHtml(popinData.text)
  : undefined;

---

<BaseLayout
    title={pageTitle}
    description="Retour très bientôt."
    bodyClass="page-maintenance"
    >

    <section class="maintenance">
        <!-- Marquee content (above background) -->
        <div class="marquee-container">
          <!-- Display marquees from maintenance page data -->
          <Marquee items={marqueeItems} />
        </div>

        <!-- Three.js Scene Container (above marquee) -->
        <!-- Use client:idle for better initial page load performance -->
        <div class="canvas-host">
            <ThreeScene client:idle />
        </div>
     
            {popinData && popinContentHtml && (
              <Popin
                id="maintenance-popin"
                title={popinData.title}
                closeable={popinData.closable}
                autoOpen={true}
              >
                <div set:html={popinContentHtml} />
              </Popin>
            )}

        
        
    </section>
</BaseLayout>
