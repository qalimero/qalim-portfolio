---
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/scenes/ThreeScene.jsx';
import Marquee from '../components/ui/Marquee.astro';
import { strapiClient } from '../lib/api/strapi';

// Utiliser le client Strapi officiel pour récupérer les données
let maintenanceData: any = null;
try {
  maintenanceData = await strapiClient.single('maintenance').find({
    populate: {
      marquee: {
        populate: '*' // Populer tous les champs du component marquee
      }
    }
  });
} catch (error) {
  console.error('Error fetching maintenance data:', error);
  maintenanceData = {
    data: {
      title: "Maintenance — Qalim",
      marquee: []
    }
  };
}


// Extraire les données du marquee depuis la réponse
const pageTitle = maintenanceData?.data?.title;
const marqueeItems = maintenanceData?.data?.marquee;

// Combiner tous les listItems en une seule chaîne séparée par des séparateurs
const marqueeText = marqueeItems.map((item: any) => item.listItem).join(' • ');

console.log(marqueeText);

---

<BaseLayout
    title={pageTitle}
    description="Retour très bientôt."
    bodyClass="page-maintenance"
    >

    <section class="maintenance">        
        <!-- Marquee content (above background) -->
        <div class="marquee-container">
          <!-- Display marquees from maintenance page data -->
          <Marquee text={marqueeText} />
        </div>

        <!-- Three.js Scene Container (above marquee) -->
        <div class="canvas-host">
            <ThreeScene client:only="react" />
        </div>
    </section>
</BaseLayout>

