---
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/scenes/ThreeScene.jsx';
import Marquee from '../components/ui/Marquee.astro';
import { getMaintenancePage } from '../lib/api/strapi';

// Fetch maintenance page data from Strapi
let maintenanceData: any = null;
try {
  maintenanceData = await getMaintenancePage();
} catch (error) {
  console.error('Error fetching maintenance data:', error);
}

// Process maintenance data for display
const marqueeComponents = maintenanceData?.data?.attributes?.marquee 
  ? maintenanceData.data.attributes.marquee.filter((marquee: any) => marquee.items?.trim())
  : [];

---

<BaseLayout
    title={maintenanceData?.data?.attributes?.title || "Maintenance — Qalim"}
    description="Retour très bientôt."
    bodyClass="page-maintenance"
    >

    <section class="maintenance">
    <!-- Background animation (behind everything) -->
    <div class="bg-anim" aria-hidden="true"></div>
    
    <!-- Marquee content (above background) -->
    <div>
      <!-- Display marquees from maintenance page data -->
      {marqueeComponents.length > 0 ? (
        marqueeComponents.map((marquee: any, index: number) => (
          <Marquee 
            text={marquee.items}
            className={` marquee-${index + 1}`}
            speed={marquee.speed ?? 1 + (index * 0.3)}
            direction={marquee.direction ?? (index % 2 === 0 ? 'left' : 'right')}
          />
        ))
      ) : (
        <Marquee
          text="Retour très bientôt..."
          speed={1}
          direction="left"
        />
      )}
    </div>

    <!-- Three.js Scene Container (above marquee) -->
    <div class="canvas-host">
        <ThreeScene client:only="react" />
    </div>
</section>
</BaseLayout>

