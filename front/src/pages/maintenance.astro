---
/**
 * Maintenance page - Displays maintenance message with animated marquee
 * Content managed via src/content/site.config.json (editable via Decap CMS)
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/scenes/ThreeScene.jsx';
import Marquee from '../components/ui/Marquee.astro';
import Popin from '../components/ui/Popin.astro';
import Button from '../components/ui/Button.astro';
import CircleTextShape from '../components/shapes/CircleTextShape.astro';

const entry = await getEntry('siteConfig', 'main');
if (!entry) throw new Error('Site config not found: src/content/site.config.json');

const { title, marquee, popinInfo, cta } = entry.data;
const popin = popinInfo?.[0];
---

<BaseLayout
  title={title}
  description="Retour très bientôt."
  bodyClass="page-maintenance"
>

  <section class="maintenance">

    {popin && (
      <Popin
        id="maintenance-popin"
        title={popin.title}
        closeable={popin.closable}
        autoOpen={true}
      >
        <p>{popin.text}</p>
      </Popin>
    )}

    <!-- Marquee content -->
    <div class="marquee-container">
      <Marquee items={marquee} />
    </div>

    {cta && (
      <div class="maintenance__cta">
        <Button
          label={cta.label}
          href={cta.href}
          variant="shape-circle"
          shape={CircleTextShape}
          shapeProps={{ text: cta.shapeText }}
          icon={cta.icon}
          iconPosition="right"
        />
      </div>
    )}

    <!-- Three.js Scene -->
    <div class="canvas-host">
      <ThreeScene client:load />
    </div>

  </section>
</BaseLayout>
