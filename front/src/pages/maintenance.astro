---
import BaseLayout from '../layouts/Layout.astro';
import ThreeScene from '../components/ThreeScene.jsx';

---

<BaseLayout
        title="Maintenance — Qalim"
        description="Retour très bientôt."
        bodyClass="page-maintenance">
<section class="stage">
    <div class="bg-anim" aria-hidden="true"></div>

    <!-- Variante A (wrap) : on enveloppe le composant pour lui donner la classe .canvas-host -->
    <div class="canvas-host">
        <ThreeScene client:only="react" />
    </div>
</section>
</BaseLayout>
